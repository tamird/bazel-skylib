"""Contracts for copying directories."""

def _copy_cmd(ctx: ctx[object, object], src: File, dst: File) -> None: ...
def _copy_bash(ctx: ctx[object, object], src: File, dst: File) -> None: ...
def copy_directory_action(ctx: ctx[object, object], src: File, dst: File, is_windows: bool = ...) -> None: ...
def _copy_directory_impl(ctx) -> list[DefaultInfo]: ...
def copy_directory(
    name: str,
    src: str | Label | select[str | Label, object],
    out: str | select[str, object],
    **kwargs: Unpack[CommonRuleAttrs],
) -> None: ...

"""Values and implementations for the common build settings."""

def BuildSettingInfo(*, value: object) -> record[{"value": object}]: ...

type _VariableAttrs = struct[{"make_variable": str}, ...]
type _StringAttrs = struct[{"make_variable": str, "values": list[str]}, ...]

class _SettingContext[T, A](Protocol):
    @property
    def attr(self) -> A: ...
    @property
    def label(self) -> Label: ...
    @property
    def build_setting_value(self) -> T: ...

def _is_valid_make_variable_char(c: str) -> bool: ...
def _get_template_variable_info(ctx: _SettingContext[object, _VariableAttrs]) -> list[TemplateVariableInfo]: ...
def _impl(ctx: _SettingContext[object, _VariableAttrs]) -> list[BuildSettingInfo | TemplateVariableInfo]: ...
def _simple_impl(ctx: _SettingContext[object, object]) -> BuildSettingInfo: ...
def _no_at_str(label: Label) -> str: ...
def _string_impl(ctx: _SettingContext[str, _StringAttrs]) -> list[BuildSettingInfo | TemplateVariableInfo]: ...

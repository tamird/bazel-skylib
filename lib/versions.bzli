"""Bazel version parsing and comparison helpers."""

def _get_bazel_version() -> str: ...

def _extract_version_number(bazel_version: str) -> str: ...

def _parse_bazel_version(bazel_version: str) -> tuple[int, ...]: ...

def _is_at_most(threshold: str, version: str) -> bool: ...

def _is_at_least(threshold: str, version: str) -> bool: ...

def _check_bazel_version(
    minimum_bazel_version: str,
    maximum_bazel_version: str | None = ...,
    bazel_version: str | None = ...,
) -> None: ...

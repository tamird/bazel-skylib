"""Path manipulation functions exported through the paths struct."""

def _basename(p: str) -> str: ...

def _dirname(p: str) -> str: ...

def _is_absolute(path: str) -> bool: ...

def _join(path: str, *others: str) -> str: ...

def _normalize(path: str) -> str: ...

def _is_normalized(str: str, look_for_same_level_references: bool = ...) -> bool: ...

def _relativize(path: str, start: str) -> str: ...

def _replace_extension(p: str, new_extension: str) -> str: ...

def _split_extension(p: str) -> tuple[str, str]: ...

def _starts_with(path_a: str, path_b: str) -> bool: ...

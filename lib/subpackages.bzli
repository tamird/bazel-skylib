"""Subpackage discovery helpers."""

def _supported() -> bool: ...

def _check_supported() -> None: ...

def _all(
    exclude: Sequence[str] = ...,
    allow_empty: bool = ...,
    fully_qualified: bool = ...,
) -> list[str]: ...

def _fully_qualified(relative_path: str) -> str: ...

def _exists(relative_path: str) -> bool: ...

"""Predicates for Starlark runtime types."""

def _a_function() -> None: ...

def _is_list(v: object) -> TypeIs[Top[list[Unknown]]]: ...

def _is_string(v: object) -> TypeIs[str]: ...

def _is_bool(v: object) -> TypeIs[bool]: ...

def _is_none(v: object) -> TypeIs[None]: ...

def _is_int(v: object) -> TypeIs[int]: ...

def _is_tuple(v: object) -> TypeIs[tuple[object, ...]]: ...

def _is_dict(v: object) -> TypeIs[Top[dict[Unknown, Unknown]]]: ...

def _is_function(v: object) -> TypeIs[function]: ...

def _is_depset(v: object) -> TypeIs[depset[object]]: ...

def _is_set(v: object) -> TypeIs[struct[{"_values": Top[dict[Unknown, Unknown]]}, ...]]: ...
